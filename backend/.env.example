# ==========================================
# NurCRM Services Backend Global Environment
# ==========================================

# General
DEBUG=False
SECRET_KEY=change_me_to_a_secure_random_string_2026

# PostgreSQL Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nurcrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_password

# Service Database Users & Passwords (Role-based isolation)
SVC_AUTH_USER=svc_auth
SVC_AUTH_PASSWORD=svc_auth_secret

SVC_CATALOG_USER=svc_catalog
SVC_CATALOG_PASSWORD=svc_catalog_secret

SVC_CLIENTS_USER=svc_clients
SVC_CLIENTS_PASSWORD=svc_clients_secret

SVC_SCHEDULE_USER=svc_schedule
SVC_SCHEDULE_PASSWORD=svc_schedule_secret

SVC_BOOKING_USER=svc_booking
SVC_BOOKING_PASSWORD=svc_booking_secret

SVC_FINANCE_USER=svc_finance
SVC_FINANCE_PASSWORD=svc_finance_secret

SVC_ANALYTICS_USER=svc_analytics
SVC_ANALYTICS_PASSWORD=svc_analytics_secret

SVC_NOTIFY_USER=svc_notify
SVC_NOTIFY_PASSWORD=svc_notify_secret

SVC_ADMIN_USER=svc_admin
SVC_ADMIN_PASSWORD=svc_admin_secret

# Redis Cache & Fast Locks
REDIS_ADDR=redis:6379

# RabbitMQ Message Broker
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Internal Service URLs
AUTH_SERVICE_URL=http://auth-service:8001
CATALOG_SERVICE_URL=http://catalog-service:8002
CLIENT_SERVICE_URL=http://client-service:8003
SCHEDULE_SERVICE_URL=http://schedule-service:8004
BOOKING_SERVICE_URL=http://booking-service:8005
FINANCE_SERVICE_URL=http://finance-service:8006
ANALYTICS_SERVICE_URL=http://analytics-service:8007
NOTIFICATION_SERVICE_URL=http://notification-service:8008

# Public JWKS URL
JWKS_URL=http://auth-service:8001/.well-known/jwks.json

# Storage
MEDIA_ROOT=/var/lib/crm/media
USE_X_ACCEL=True
