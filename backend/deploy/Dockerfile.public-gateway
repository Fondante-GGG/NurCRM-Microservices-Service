FROM golang:1.22-alpine AS builder

WORKDIR /app

COPY libs/go_common ./libs/go_common
COPY services/public-gateway ./services/public-gateway

WORKDIR /app/services/public-gateway
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/public-gateway ./cmd/main.go

FROM alpine:3.19
WORKDIR /app
COPY --from=builder /app/public-gateway .
EXPOSE 8010
CMD ["./public-gateway"]
