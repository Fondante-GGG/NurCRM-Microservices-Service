FROM golang:1.22-alpine AS builder

WORKDIR /app

COPY services/scheduler-worker ./services/scheduler-worker

WORKDIR /app/services/scheduler-worker
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/scheduler-worker ./cmd/main.go

FROM alpine:3.19
WORKDIR /app
COPY --from=builder /app/scheduler-worker .
CMD ["./scheduler-worker"]
