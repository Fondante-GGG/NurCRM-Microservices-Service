# Client Service Environment
PORT=8003
DEBUG=False
SECRET_KEY=change_me_to_client_service_secret_key_2026

# PostgreSQL Database (clients schema)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nurcrm
DB_USER=svc_clients
DB_PASSWORD=svc_clients_secret
DB_SCHEMA=clients

# File Storage for Documents & Photos (Max 10MB per file)
MEDIA_STORAGE_PATH=/var/lib/crm/media/clients
USE_X_ACCEL=True
MAX_UPLOAD_SIZE_MB=10

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
