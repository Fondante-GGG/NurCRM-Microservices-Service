# Auth Service Environment
PORT=8001
DEBUG=False
SECRET_KEY=change_me_to_auth_service_secret_key_2026

# PostgreSQL Database (auth schema)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nurcrm
DB_USER=svc_auth
DB_PASSWORD=svc_auth_secret
DB_SCHEMA=auth

# JWT RSA Keys (Optional: if not set, auto-generates in-memory pair)
# RSA_PRIVATE_KEY_PATH=/etc/nurcrm/jwt/private.pem
# RSA_PUBLIC_KEY_PATH=/etc/nurcrm/jwt/public.pem
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
