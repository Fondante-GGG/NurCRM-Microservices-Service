# Скопируй этот файл в .env.local и поправь под свой сервер.

# Адрес шлюза бэкенда «Услуги» (Nginx). Локально у Беки — http://localhost, на стейдже — его адрес.
NURCRM_API_URL=http://localhost
# Путь входа (по API_REFERENCE.md: POST /api/v1/auth/login/, вход по email).
NURCRM_LOGIN_PATH=/api/v1/auth/login/
# 1 — вход без сервера, для разработки: открывает выбор раздела вручную. В проде не включать.
NURCRM_DEV_LOGIN=0

# Ключи для AI-Консультанта (цепочка отказоустойчивости: Gemini -> Claude -> OpenAI/Codex)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
